{
  "manifest_version": 3,
  "name": "Aeroplan bridge",
  "version": "1.5",
  "description": "Runs Aeroplan award searches in this signed-in tab for the aeroplan_value.py command-line tool.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "alarms",
    "debugger"
  ],
  "host_permissions": [
    "https://www.aircanada.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.aircanada.com/aeroplan/redeem/*"
      ],
      "js": [
        "page_hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.aircanada.com/aeroplan/redeem/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start"
    }
  ]
}
