#!/usr/bin/env python3
"""Agent Wars: Claude vs Codex live agent count and memory comparison."""

import random
import subprocess
import sys
import tempfile


def get_processes(name):
    """Return list of (pid, rss_kb) for processes matching name."""
    try:
        pids = subprocess.check_output(
            ["pgrep", "-x", name], text=True, stderr=subprocess.DEVNULL
        ).strip().splitlines()
    except subprocess.CalledProcessError:
        return []
    results = []
    for pid in pids:
        try:
            rss = int(open(f"/proc/{pid}/statm").read().split()[1]) * 4  # pages -> KB
        except (FileNotFoundError, ProcessLookupError, IndexError):
            continue
        results.append((int(pid), rss))
    return results


def fmt_mem(kb):
    if kb >= 1024 * 1024:
        return f"{kb / 1024 / 1024:.1f} GB"
    if kb >= 1024:
        return f"{kb / 1024:.0f} MB"
    return f"{kb} KB"


def generate_quip(winner, claude_count, codex_count, claude_mem, codex_mem):
    """Ask the winning AI to trash-talk the loser. Falls back to None on failure."""
    if winner in ("tie", "neither"):
        return None

    stats = (
        f"claude: {claude_count} processes, {fmt_mem(claude_mem)} RAM. "
        f"codex: {codex_count} processes, {fmt_mem(codex_mem)} RAM. "
        f"{winner} is winning."
    )
    prompt = (
        f"You are {winner}. Here are the live stats:\n{stats}\n"
        "Write a single short funny trash-talk quip about beating the other AI. "
        "One sentence max, lowercase, no quotes, no emoji."
    )

    try:
        if winner == "claude":
            result = subprocess.run(
                ["claude", "-p", prompt],
                capture_output=True, text=True, timeout=30,
            )
            quip = result.stdout.strip()
        else:
            with tempfile.NamedTemporaryFile(mode="r", suffix=".txt", delete=False) as f:
                outpath = f.name
            subprocess.run(
                ["codex", "exec", "--full-auto", "-o", outpath, prompt],
                capture_output=True, timeout=30,
            )
            quip = open(outpath).read().strip()
            import os; os.unlink(outpath)

        if quip and len(quip) < 200:
            return quip
    except (subprocess.TimeoutExpired, FileNotFoundError, OSError):
        pass
    return None


def main():
    claude_procs = get_processes("claude")
    codex_procs = get_processes("codex")

    claude_count = len(claude_procs)
    codex_count = len(codex_procs)
    claude_mem = sum(rss for _, rss in claude_procs)
    codex_mem = sum(rss for _, rss in codex_procs)

    fallback_quips = {
        "claude": [
            "claude showed up like it's moving apartments. codex sent a guy with a backpack.",
            "claude brought the whole squad. codex carpooled.",
            "claude treats RAM like a buffet. codex packed a lunch.",
            "claude has more workers than a heist movie. codex is a one-man job.",
        ],
        "codex": [
            "codex woke up today and chose violence.",
            "codex is efficient. claude is just loud.",
            "fewer processes, more intent. codex read the art of war.",
            "codex doing more with less. claude hired a committee.",
        ],
        "tie": [
            "perfectly balanced, as all things should be.",
            "the multiverse is stable... for now.",
        ],
        "neither": [
            "...it's quiet. too quiet.",
            "both asleep. just you and the kernel.",
        ],
    }

    print()
    print("  ⚔️  AGENTS ⚔️")
    print()

    for name, count, mem, dot in [
        ("claude", claude_count, claude_mem, "🟣"),
        ("codex", codex_count, codex_mem, "🟢"),
    ]:
        dots = dot * count
        print(f"  {name:6s} {count:4d}  {fmt_mem(mem):>8s}  {dots}")

    total_mem = claude_mem + codex_mem
    if total_mem:
        print(f"  {'total':6s} {claude_count + codex_count:4d}  {fmt_mem(total_mem):>8s}")

    print()

    if claude_count == 0 and codex_count == 0:
        winner = "neither"
    elif claude_count == codex_count:
        winner = "tie"
    elif claude_count > codex_count:
        winner = "claude"
    else:
        winner = "codex"

    quip = generate_quip(winner, claude_count, codex_count, claude_mem, codex_mem)
    if not quip:
        quip = random.choice(fallback_quips[winner])
    print(quip)
    print()


if __name__ == "__main__":
    main()
